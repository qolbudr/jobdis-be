# Database
DATABASE_URL=mysql://root@localhost:3306/jobdis

# Auth
JWT_SECRET=change-me

# AI recommendations (Pollinations.AI — OpenAI compatible)
# Docs: https://gen.pollinations.ai/docs
# Endpoint used: POST https://text.pollinations.ai/openai
#
# Optional. When unset, the client falls back to the anonymous tier.
# A token raises rate limits and can disable public logging of prompts.
POLLINATIONS_TOKEN=
# Optional. Explicit model id (preferred over the moving "openai" alias).
# Current anonymous default: openai-fast (gpt-oss-20b).
POLLINATIONS_MODEL=openai
